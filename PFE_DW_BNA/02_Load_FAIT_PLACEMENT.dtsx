    ///  Row.ZipCode = zipCode
    /// </summary>
    /// <param name="Row">The row that is currently passing through the component</param>
    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        // Connexion � ta base de donn�es DW
        string connStr = "Data Source=.;Initial Catalog=DW_BNA_Placements;Integrated Security=True;";

        using (var conn = new System.Data.SqlClient.SqlConnection(connStr))
        {
            conn.Open();

            // --- Calcul Maturit� Contractuelle ---
            string sqlContract = "SELECT TOP 1 ID_MATURITE FROM DW.DIM_MATURITE WHERE @nb BETWEEN NB_JOURS_MIN AND NB_JOURS_MAX";
            using (var cmd = new System.Data.SqlClient.SqlCommand(sqlContract, conn))
            {
                cmd.Parameters.AddWithValue("@nb", Row.NBJOURS); // NB_JOURS du flux
                var result = cmd.ExecuteScalar();
                Row.IDMATURITECONTRAT = result != null ? (int)result : 1; // si pas trouv� ? 1 par d�faut
            }

            // --- Calcul Maturit� R�siduelle ---
            // NB: ici tu peux calculer NB_JOURS_RESIDUELLE avant, ou directement utiliser un autre param�tre
            string sqlResidual = "SELECT TOP 1 ID_MATURITE FROM DW.DIM_MATURITE WHERE @nb BETWEEN NB_JOURS_MIN AND NB_JOURS_MAX";
            using (var cmdResidual = new System.Data.SqlClient.SqlCommand(sqlResidual, conn))
            {
                int nbResiduel = Row.NBJOURSRESIDUELS; // exemple si tu l�as d�j� calcul�
                cmdResidual.Parameters.AddWithValue("@nb", nbResiduel);
                var resultResidual = cmdResidual.ExecuteScalar();
                Row.IDMATURITERESIDUELLE = resultResidual != null ? (int)resultResidual : 14;
            }
        }
    }

}
